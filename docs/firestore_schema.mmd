erDiagram
    USERS ||--o{ OPPORTUNITIES : publishes
    USERS ||--o{ APPLICATIONS : submits
    USERS ||--o{ BOOKMARK_ITEMS : saves
    OPPORTUNITIES ||--o{ APPLICATIONS : receives
    USERS {
      string uid PK
      string name
      string email
      string role
      array skills
      map cvAnalysis
      timestamp updatedAt
    }
    OPPORTUNITIES {
      string opportunityId PK
      string ownerId FK
      string role
      string startupName
      string status
      bool isPaid
      number monthlyAmount
      string currency
      timestamp deadline
      array skills
    }
    APPLICATIONS {
      string applicationId PK
      string opportunityId FK
      string studentId FK
      string founderId FK
      string motivation
      string availability
      string status
      bool isDemo
      timestamp createdAt
    }
    BOOKMARK_ITEMS {
      string userId FK
      string opportunityId FK
      timestamp savedAt
    }
