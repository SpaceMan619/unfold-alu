rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function user() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isFounder() {
      return signedIn() && user().data.role == 'founder';
    }

    function isAdmin() {
      return signedIn() && user().data.role == 'admin';
    }

    function hasAluEmail() {
      return signedIn()
        && request.auth.token.email.matches('.*@(alustudent\\.com|alueducation\\.com)$');
    }

    function hasValidDeadline() {
      return !('deadline' in request.resource.data)
        || request.resource.data.deadline == null
        || request.resource.data.deadline is timestamp;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if hasAluEmail() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /startups/{startupId} {
      allow read: if signedIn();
      allow create: if isFounder()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.verificationStatus == 'pending';
      allow update: if isAdmin()
        || (isFounder() && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.verificationStatus == resource.data.verificationStatus);
      allow delete: if isAdmin();
    }

    match /opportunities/{opportunityId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && hasValidDeadline();
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && hasValidDeadline());
      allow delete: if isAdmin()
        || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /applications/{applicationId} {
      allow create: if signedIn()
        && request.resource.data.founderId is string
        && (
          (request.resource.data.isDemo == true
            && applicationId.matches('demo-applicant-.*')
            && request.resource.data.opportunityId == 'demo-founder-role'
            && request.resource.data.founderId == request.auth.uid
            && request.resource.data.studentId.matches('demo-student-.*')
            && request.resource.data.status in
              ['submitted', 'reviewing', 'shortlisted', 'waitlisted', 'accepted', 'rejected'])
          || (request.resource.data.studentId == request.auth.uid
            && request.resource.data.status == 'submitted'
            && request.resource.data.opportunityId.matches('demo-.*')
            && request.resource.data.founderId == 'unfold-seed')
          || (request.resource.data.studentId == request.auth.uid
            && request.resource.data.status == 'submitted'
            && exists(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId))
            && get(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId)).data.ownerId
              == request.resource.data.founderId
          )
        );
      allow read: if signedIn()
        && (applicationId.matches('demo-applicant-' + request.auth.uid + '-.*')
          || resource.data.studentId == request.auth.uid
          || resource.data.founderId == request.auth.uid
          || isAdmin());
      allow update: if signedIn()
        && (resource.data.founderId == request.auth.uid || isAdmin())
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.founderId == resource.data.founderId
        && request.resource.data.opportunityId == resource.data.opportunityId
        && request.resource.data.status in
          ['submitted', 'reviewing', 'shortlisted', 'waitlisted', 'accepted', 'rejected'];
      allow delete: if signedIn()
        && resource.data.studentId == request.auth.uid;
    }

    match /bookmarks/{userId}/items/{opportunityId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }
  }
}
